<Window x:Class="StayXCapture.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:StayXCapture.Wpf.Converters"
        mc:Ignorable="d"
        Title="StayX Capture" 
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="640" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="Window_Deactivated">
    
    <Window.Resources>
        <conv:ImagePathToThumbnailConverter x:Key="ImagePathConverter" />
        
        
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="CaptureButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern scrollbar styles -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="2,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.4"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ToggleTrackOffBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0,0,10,0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Claymorphism ContextMenu Styles -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowColor}" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.4"/>
                            </Border.Effect>
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style -->
        <Style TargetType="CheckBox" x:Key="ToggleSwitchStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ToggleTrackOffBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToggleTrackBorderOffBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="SwitchTrack" Width="46" Height="26" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="2" Opacity="0.5" Color="{DynamicResource ShadowColor}" />
                                </Border.Effect>
                                <Grid>
                                    <Border x:Name="SwitchThumb" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ToggleThumbBrush}" HorizontalAlignment="Left" Margin="1,0">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="3" Opacity="0.3" Color="{DynamicResource ToggleThumbShadowColor}"/>
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Off Icon -->
                                            <Path x:Name="OffIcon" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource ToggleIconOffBrush}" StrokeThickness="2.5" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <!-- On Icon -->
                                            <Path x:Name="OnIcon" Data="M0,5 L4,9 L10,1" Stroke="{DynamicResource ToggleIconOnBrush}" StrokeThickness="2.5" Stretch="Uniform" Width="11" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleTrackOnBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleTrackBorderOnBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="OffIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="OnIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Switch Toggle Style -->
        <Style TargetType="CheckBox" x:Key="ThemeToggleStyle">
            <Setter Property="Background" Value="{DynamicResource ToggleTrackOffBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="50" Height="26" CornerRadius="13" Background="{TemplateBinding Background}" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand">
                            <Grid>
                                <!-- Icons fixed in background -->
                                <Path Data="M13,3 A10,10 0 1,1 3,13 A7,7 0 0,0 13,3 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <Path Data="M5,0 L5,2 M5,8 L5,10 M0,5 L2,5 M8,5 L10,5 M1.5,1.5 L3,3 M7,7 L8.5,8.5 M1.5,8.5 L3,7 M7,3 L8.5,1.5 M5,5 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                
                                <!-- Sliding Thumb -->
                                <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Right" Margin="2">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="3" Opacity="0.2" Color="{DynamicResource ToggleThumbShadowColor}"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- Active Moon (Dark Mode) -->
                                        <Path x:Name="ActiveMoon" Data="M13,3 A10,10 0 1,1 3,13 A7,7 0 0,0 13,3 Z" Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Active Sun (Light Mode) -->
                                        <Path x:Name="ActiveSun" Data="M5,0 L5,2 M5,8 L5,10 M0,5 L2,5 M8,5 L10,5 M1.5,1.5 L3,3 M7,7 L8.5,8.5 M1.5,8.5 L3,7 M7,3 L8.5,1.5 M5,5 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" Fill="Transparent" Stroke="#F59E0B" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="ActiveMoon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ActiveSun" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" 
            CornerRadius="24" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" Direction="270" ShadowDepth="4" BlurRadius="15" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="7" Width="26" Height="26" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="StayX Capture" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkThemeToggle" Style="{StaticResource ThemeToggleStyle}" Margin="0,0,12,0" Checked="ChkThemeToggle_Checked" Unchecked="ChkThemeToggle_Unchecked"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- Minimize to Tray Button -->
                    <Button x:Name="BtnMinimize" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click" ToolTip="Minimize to Tray" Margin="0,0,4,0">
                        <TextBlock Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Close to Tray Button -->
                    <Button x:Name="BtnClose" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" ToolTip="Close to Tray">
                        <TextBlock Text="✕" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <!-- Home Tab -->
                <Grid x:Name="TabHome" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource CaptureButton}" Click="BtnRegion_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/regioncapture.png" Width="50" Height="50" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Region" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="LblHotkeyRegion" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource CaptureButton}" Click="BtnFullScreen_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/fullscreen.png" Width="50" Height="50" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Full Screen" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="LblHotkeyFullscreen" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CLIPBOARD" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListView x:Name="ClipboardList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10" Margin="0,5">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy" Click="CtxClipboardCopy_Click"/>
                                                    <MenuItem Header="Delete" Click="CtxClipboardDelete_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Clear All" Click="CtxClipboardClearAll_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Data}" FontSize="12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="#A1A1AA" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- History Tab -->
                <Grid x:Name="TabHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="RECENT CAPTURES" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="20,20,20,10"/>
                    <ListView x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="10" Margin="0,6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="5" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Click="CtxHistoryCopy_Click"/>
                                            <MenuItem Header="Show in Explorer" Click="CtxHistoryExplorer_Click"/>
                                            <MenuItem Header="Open Editor" Click="CtxHistoryEditor_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="CtxHistoryDelete_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Thumbnail -->
                                        <Border CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,16,0" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Image Source="{Binding Data, Converter={StaticResource ImagePathConverter}}" MaxHeight="90" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        
                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="#A1A1AA" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="#8A8A96" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
                
                <!-- API Tab -->
                <Grid x:Name="TabApi" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="UPLOAD &amp; SHARE" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Upload your captures directly to a custom API server or cloud provider and automatically copy the URL." Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="12"/>
                            
                            <CheckBox x:Name="ChkAutoUpload" Style="{StaticResource ToggleSwitchStyle}" Content="Upload automatically after capture" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkAskBeforeUpload" Style="{StaticResource ToggleSwitchStyle}" Content="Ask to upload after every capture" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            
                            <TextBlock Text="Custom API Endpoint" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,2" FontWeight="Medium"/>
                            <TextBlock Text="POST destination server URL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtApiEndpoint" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="8" TextChanged="Setting_Changed"/>

                            <TextBlock Text="Custom API Key / Token" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,2" FontWeight="Medium"/>
                            <TextBlock Text="Authorization API key or Bearer token" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtCustomApiKey" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="8" TextChanged="Setting_Changed"/>
                            
                            <TextBlock Text="ImgBB API Key" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,5" FontWeight="Medium"/>
                            <TextBox x:Name="TxtImgbbApiKey" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="8" TextChanged="Setting_Changed"/>

                            <TextBlock Text="Google Drive API Key" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,5" FontWeight="Medium"/>
                            <TextBox x:Name="TxtGoogleDriveApiKey" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="8" TextChanged="Setting_Changed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                
                <!-- Settings Tab -->
                <Grid x:Name="TabSettings" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            
                            <TextBlock Text="PREFERENCES" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            
                            <CheckBox x:Name="ChkAutoOrganize" Style="{StaticResource ToggleSwitchStyle}" Content="Auto-organize (save in date folders)" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkCopyClipboard" Style="{StaticResource ToggleSwitchStyle}" Content="Copy to Clipboard automatically" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkOpenEditor" Style="{StaticResource ToggleSwitchStyle}" Content="Open Editor after capture" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkPromptDisplaySelection" Style="{StaticResource ToggleSwitchStyle}" Content="Select display on fullscreen capture" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkStartMinimized" Style="{StaticResource ToggleSwitchStyle}" Content="Start Minimized" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkAutoStart" Style="{StaticResource ToggleSwitchStyle}" Content="Start with Windows" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkMonitorClipboard" Style="{StaticResource ToggleSwitchStyle}" Content="Monitor Clipboard" Margin="0,7" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            
                            <TextBlock Text="SHORTCUTS" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Region Capture:" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox x:Name="TxtHotkeyRegion" Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5" Margin="0,5" IsReadOnly="True" KeyDown="TxtHotkey_KeyDown" GotFocus="TxtHotkey_GotFocus" LostFocus="TxtHotkey_LostFocus"/>
                                
                                <TextBlock Text="Fullscreen Capture:" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                                <TextBox x:Name="TxtHotkeyFullscreen" Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5" Margin="0,5" IsReadOnly="True" KeyDown="TxtHotkey_KeyDown" GotFocus="TxtHotkey_GotFocus" LostFocus="TxtHotkey_LostFocus"/>
                            </Grid>
                            
                            <TextBlock Text="SAVE LOCATION" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSaveFolder" IsReadOnly="True" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="5"/>
                                <Button Content="Browse" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource NavButton}" Click="BrowseFolder_Click"/>
                            </Grid>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Bottom Navigation -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Margin="0,16,0,0" Padding="5">
                <UniformGrid Columns="4">
                    <Button Content="Home" Style="{StaticResource NavButton}" Click="NavHome_Click"/>
                    <Button Content="History" Style="{StaticResource NavButton}" Click="NavHistory_Click"/>
                    <Button Content="API" Style="{StaticResource NavButton}" Click="NavApi_Click"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
