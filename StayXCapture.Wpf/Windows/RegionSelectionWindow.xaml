<Window x:Class="StayXCapture.Wpf.Windows.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#40000000"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas">
        <!-- The transparent cutout area where the user selects -->
        <Path x:Name="SelectionPath" Fill="#00000000" Stroke="#6366F1" StrokeThickness="2" StrokeDashArray="2,2"/>
    </Canvas>
</Window>
