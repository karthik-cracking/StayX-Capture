<Window x:Class="StayXCapture.Wpf.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayX Editor" 
        Icon="pack://application:,,,/Assets/app_icon.png"
        Height="820" Width="1240"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Sleek Dark ScrollBar Styles -->
        <Style x:Key="ScrollBarTrackRepeatBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="#383842"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#52525E"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#1E1E24">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackRepeatBtn}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackRepeatBtn}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="#1E1E24">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackRepeatBtn}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackRepeatBtn}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Toolbar Tool Button (Radio) -->
        <Style TargetType="RadioButton" x:Key="ToolBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#09090B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Toggle Button Style -->
        <Style TargetType="ToggleButton" x:Key="DropdownToggleBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A36"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Swatch Item in Color Popup -->
        <Style TargetType="Button" x:Key="SwatchItemBtn">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="1.5">
                            <Border x:Name="InnerBorder" Background="{TemplateBinding Background}" CornerRadius="9"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thickness Menu Item in Thickness Popup -->
        <Style TargetType="Button" x:Key="ThicknessMenuItemBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button -->
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Save) -->
        <Style TargetType="Button" x:Key="PrimaryActionBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Upload Action Button -->
        <Style TargetType="Button" x:Key="UploadActionBtn" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Undo/Redo Icon Button -->
        <Style TargetType="Button" x:Key="HistoryBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom Icon Button (+ / -) -->
        <Style TargetType="Button" x:Key="ZoomIconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom Value Button (100%) -->
        <Style TargetType="Button" x:Key="ZoomValueBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom Fit Button -->
        <Style TargetType="Button" x:Key="ZoomFitBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Buttons (Minimize, Maximize, Close) -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainRootBorder" Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Unified Dark Header Bar (No Scrollbars, Everything Always Visible!) -->
                <RowDefinition Height="48"/>
                <!-- Viewport Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Unified Dark Header & Toolbar -->
            <Border Grid.Row="0" Background="#141419" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">

                    <!-- Left: Logo & Branding -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/Assets/app_icon.png" Width="18" Height="18" Margin="4,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="StayX Editor" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Drawing Tools Pill -->
                    <Border DockPanel.Dock="Left" Background="#1C1C24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3,2" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="✎ Pen" Style="{StaticResource ToolBtn}" IsChecked="True" Checked="Tool_Checked" Tag="Pen" ToolTip="Freehand Pen drawing"/>
                            <RadioButton Content="🖌 Highlight" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Highlight" ToolTip="Highlighter"/>
                            <RadioButton Content="↗ Arrow" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Arrow" ToolTip="Draw pointing arrows"/>
                            <RadioButton Content="▭ Rect" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Rectangle" ToolTip="Draw rectangular frames"/>
                            <RadioButton Content="░ Blur" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Blur" ToolTip="Pixelate / Redact sensitive information"/>
                            <RadioButton Content="T Text" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Text" ToolTip="Add text annotation"/>
                            <RadioButton Content="⌫ Eraser" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" Tag="Eraser" ToolTip="Erase ink strokes"/>
                        </StackPanel>
                    </Border>

                    <!-- Dropdowns Pill (Color + Thickness) -->
                    <Border DockPanel.Dock="Left" Background="#1C1C24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,2" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Color Dropdown -->
                            <ToggleButton x:Name="BtnColorDropdown" Style="{StaticResource DropdownToggleBtn}" ToolTip="Select Color">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="CurrentColorCircle" Width="14" Height="14" CornerRadius="7" Background="#EF4444" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,4,0"/>
                                    <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Color Popup -->
                            <Popup x:Name="ColorPopup" 
                                   PlacementTarget="{Binding ElementName=BtnColorDropdown}" 
                                   Placement="Bottom" 
                                   StaysOpen="False" 
                                   IsOpen="{Binding ElementName=BtnColorDropdown, Path=IsChecked, Mode=TwoWay}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="#1C1C24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <UniformGrid Columns="4" Rows="2">
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#EF4444" Tag="#EF4444" Click="Color_Select_Click" ToolTip="Red"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#F97316" Tag="#F97316" Click="Color_Select_Click" ToolTip="Orange"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#F59E0B" Tag="#F59E0B" Click="Color_Select_Click" ToolTip="Yellow"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#10B981" Tag="#10B981" Click="Color_Select_Click" ToolTip="Green"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#3B82F6" Tag="#3B82F6" Click="Color_Select_Click" ToolTip="Blue"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#8B5CF6" Tag="#8B5CF6" Click="Color_Select_Click" ToolTip="Purple"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#FFFFFF" Tag="#FFFFFF" Click="Color_Select_Click" ToolTip="White"/>
                                        <Button Style="{StaticResource SwatchItemBtn}" Background="#18181B" Tag="#18181B" Click="Color_Select_Click" ToolTip="Black"/>
                                    </UniformGrid>
                                </Border>
                            </Popup>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="3,0"/>

                            <!-- Thickness Dropdown -->
                            <ToggleButton x:Name="BtnThicknessDropdown" Style="{StaticResource DropdownToggleBtn}" ToolTip="Line Thickness">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCurrentThickness" Text="4px" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Thickness Popup -->
                            <Popup x:Name="ThicknessPopup"
                                   PlacementTarget="{Binding ElementName=BtnThicknessDropdown}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   IsOpen="{Binding ElementName=BtnThicknessDropdown, Path=IsChecked, Mode=TwoWay}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="#1C1C24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="4" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Width="84">
                                        <Button Content="1px" Tag="1" Style="{StaticResource ThicknessMenuItemBtn}" Click="Thickness_Select_Click" ToolTip="1px (Fine)"/>
                                        <Button Content="2px" Tag="2" Style="{StaticResource ThicknessMenuItemBtn}" Click="Thickness_Select_Click" ToolTip="2px (Thin)"/>
                                        <Button Content="4px" Tag="4" Style="{StaticResource ThicknessMenuItemBtn}" Click="Thickness_Select_Click" ToolTip="4px (Medium)"/>
                                        <Button Content="8px" Tag="8" Style="{StaticResource ThicknessMenuItemBtn}" Click="Thickness_Select_Click" ToolTip="8px (Thick)"/>
                                        <Button Content="12px" Tag="12" Style="{StaticResource ThicknessMenuItemBtn}" Click="Thickness_Select_Click" ToolTip="12px (Bold)"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- History & Zoom Pill -->
                    <Border DockPanel.Dock="Left" Background="#1C1C24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,2" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnUndo" Content="↶" Style="{StaticResource HistoryBtn}" FontSize="15" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" IsEnabled="False" Opacity="0.4"/>
                            <Button x:Name="BtnRedo" Content="↷" Style="{StaticResource HistoryBtn}" FontSize="15" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" IsEnabled="False" Opacity="0.4"/>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                            <Button Content="−" Style="{StaticResource ZoomIconBtn}" Click="ZoomOut_Click" ToolTip="Zoom Out (Mouse Wheel Down / Ctrl -)"/>
                            <Button x:Name="BtnZoomValue" Content="100%" Style="{StaticResource ZoomValueBtn}" Click="ZoomReset_Click" ToolTip="Reset to 100% 1:1 scale (Ctrl+1)"/>
                            <Button Content="+" Style="{StaticResource ZoomIconBtn}" Click="ZoomIn_Click" ToolTip="Zoom In (Mouse Wheel Up / Ctrl +)"/>
                            <Button Content="⛶ Fit" Style="{StaticResource ZoomFitBtn}" Click="ZoomFit_Click" ToolTip="Fit Image to Window (Ctrl+0)"/>
                        </StackPanel>
                    </Border>

                    <!-- 1. Far Right: Window Buttons (Minimize, Maximize, Close) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="2,0,6,0"/>
                        <Button Content="🗕" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="BtnMaximize" Content="🗖" Style="{StaticResource WindowControlBtn}" Click="BtnMaximize_Click" ToolTip="Maximize"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" ToolTip="Close (Esc)"/>
                    </StackPanel>

                    <!-- 2. Next on Right: Actions (Copy, Upload, Save) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="Copy" Style="{StaticResource ActionBtn}" Click="Copy_Click" ToolTip="Copy to clipboard (Ctrl+C)"/>
                        <Button x:Name="BtnUpload" Content="☁ Upload" Style="{StaticResource UploadActionBtn}" Click="Upload_Click" ToolTip="Upload directly to API and copy URL (Ctrl+U)"/>
                        <Button Content="Save" Style="{StaticResource PrimaryActionBtn}" Click="Save_Click" ToolTip="Save to disk (Ctrl+S)"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Canvas / Viewport Area -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="ImageScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto" 
                              Background="{DynamicResource AppBackgroundBrush}"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                              PreviewMouseDown="ScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="ScrollViewer_PreviewMouseUp">
                    <Grid MinWidth="{Binding ElementName=ImageScrollViewer, Path=ViewportWidth}"
                          MinHeight="{Binding ElementName=ImageScrollViewer, Path=ViewportHeight}">
                        <Border Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" BlurRadius="25" Opacity="0.6"/>
                            </Border.Effect>
                            <Grid x:Name="CanvasContainer">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="BaseImage" Stretch="None"/>
                                <InkCanvas x:Name="DrawingCanvas" Background="Transparent" />
                                <!-- Shapes overlay -->
                                <Canvas x:Name="ShapesCanvas" Background="Transparent" 
                                        MouseDown="ShapesCanvas_MouseDown" 
                                        MouseMove="ShapesCanvas_MouseMove" 
                                        MouseUp="ShapesCanvas_MouseUp"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Bottom Left Image Info Pill -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Background="#D918181F" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtImageInfo" Text="1920 × 1080 px" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
