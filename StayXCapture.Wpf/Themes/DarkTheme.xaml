<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme (Claymorphism) -->
    
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="ToggleThumbShadowColor">#000000</Color>
    
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E24"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#25252D"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#383842"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#666666"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2D2D36"/>
    
    <!-- Toggle Switch Colors -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#383842"/>
    <SolidColorBrush x:Key="ToggleTrackOnBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="ToggleTrackBorderOffBrush" Color="#25252D"/>
    <SolidColorBrush x:Key="ToggleTrackBorderOnBrush" Color="#059669"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#F4F4F5"/>
    
    <SolidColorBrush x:Key="ToggleIconOffBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="ToggleIconOnBrush" Color="#10B981"/>

    <!-- Shared status colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
</ResourceDictionary>
